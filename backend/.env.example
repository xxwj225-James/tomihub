# ==========================================
# AI-PM Backend — Environment Variables
# ==========================================
# Copy to .env: cp .env.example .env

# Database
DB_URL=jdbc:postgresql://localhost:5432/ai_pm
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT (RS256 key pair — generate with: openssl genrsa ...)
JWT_PRIVATE_KEY=classpath:keys/private.pem
JWT_PUBLIC_KEY=classpath:keys/public.pem

# SMTP (for verification emails)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxx

# Service URLs (dev: use localhost)
AUTH_URL=http://localhost:8081
TENANT_URL=http://localhost:8083
CORE_URL=http://localhost:8082
NOTIFY_URL=http://localhost:8084
WEBHOOK_URL=http://localhost:8085
AI_BRAIN_URL=http://localhost:8000
