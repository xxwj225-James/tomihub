# ─────────────────────────────────────────────────────────
# TomiHub (no-AI open edition) — docker environment template
# Copy to .env and fill in:  cp .env.example .env
# Then generate JWT keys:    bash gen-keys.sh
# ─────────────────────────────────────────────────────────

# ─── JWT signing keys (REQUIRED — generated by gen-keys.sh) ───
# Private key: PKCS#8 single-line PEM (openssl pkcs8 -topk8 -nocrypt)
# Public key:  PEM without the BEGIN/END lines, single line
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── DB / infra (defaults match docker-compose.yml) ───
POSTGRES_DB=ai_pm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── App ───
# Public base URL (drives links/redirects)
APP_BASE_URL=http://localhost
# Encryption key for secrets at rest — change to a random 16+ char string
ENCRYPT_KEY=change-me-to-a-random-string

# ─── Network (optional proxies) ───
# HTTPS_PROXY=
# HTTP_PROXY=
# ALL_PROXY=
# NO_PROXY=

# ─── IPv6 (false for cloud VMs without IPv6) ───
ENABLE_IPV6=false
