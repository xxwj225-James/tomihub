<script>
/* ═══ View Switching ═══ */
function show(name) {
  document.querySelectorAll('[id^="v-"]').forEach(el => el.classList.add('view-off'));
  const target = document.getElementById('v-' + name);
  if (target) target.classList.remove('view-off');
  document.querySelectorAll('.nav').forEach(n => n.classList.remove('act'));
  const link = document.querySelector(`.nav[data-v="${name}"]`);
  if (link) link.classList.add('act');
}

/* ═══ Theme ═══ */
function setT(name) {
  document.documentElement.setAttribute('data-theme', name);
  document.querySelectorAll('.tdot').forEach(d => d.classList.remove('act'));
  document.querySelector(`.tdot[data-theme="${name}"]`).classList.add('act');
}

/* ═══ Language ═══ */
let lang = 'en';
function toggleLang() {
  lang = lang === 'en' ? 'zh' : 'en';
  document.getElementById('langLabel').textContent = lang.toUpperCase();
}
</script>
