<!-- ─── REPORTS ─── -->
<div id="v-reports" class="view-off">
<div class="ch"><h2>Reports</h2><span class="fs12 muted">AI-generated reports — share with your team via email or in-app</span></div>
<div class="cb"><div style="max-width:900px">

  <!-- ═══ Generate Section ═══ -->
  <div class="card ai-glow mb4">
    <div class="card-hd"><div class="flex items-center gap3">
      <span class="fs12 fw6 muted">Type:</span>
      <button class="btn btn-s fs13" style="background:hsl(var(--brand-s));color:hsl(var(--brand));font-weight:600">Daily</button>
      <button class="btn btn-s fs13">Weekly</button>
      <button class="btn btn-s fs13">Monthly</button>
      <button class="btn btn-s fs13">Sprint Review</button>
    </div></div>
    <div class="card-bd" style="padding:20px 24px">

      <!-- ★ BEFORE generation — empty state -->
      <div id="gen-empty">
        <div class="text-c" style="padding:40px 20px">
          <p style="font-size:40px;margin-bottom:12px">🤖</p>
          <h3 style="font-size:16px;margin-bottom:6px" class="text-ink-primary">Generate Daily Report</h3>
          <p class="fs13 muted mb4">AI will analyze your recent activity and create a draft.</p>
          <div class="mb4" style="max-width:420px;margin:0 auto 16px">
            <textarea class="form-input" style="min-height:60px;padding:10px 14px;font-size:13px;width:100%" placeholder="Optional: describe what to focus on. e.g. Focus on AIPM project only. Highlight P0 bugs."></textarea>
          </div>
          <button class="btn btn-b" style="padding:12px 32px;font-size:14px" onclick="document.getElementById('gen-empty').classList.add('view-off');document.getElementById('gen-done').classList.remove('view-off')">🤖 Generate</button>
        </div>
      </div>

      <!-- ★ AFTER generation — report content -->
      <div id="gen-done" class="view-off">
        <div class="flex items-center justify-between mb4">
          <h3 style="font-size:16px">Daily Report — Alice</h3>
          <div class="flex gap2">
            <button class="btn btn-s btn-xs" onclick="document.getElementById('prompt-modal').classList.remove('view-off')">🤖 Regenerate</button>
            <button class="btn btn-s btn-xs">💾 Save</button>
            <button class="btn btn-s btn-xs" onclick="document.getElementById('share-modal').classList.remove('view-off')">↗ Share</button>
            <button class="btn btn-b btn-xs" onclick="document.getElementById('emod2').classList.remove('view-off')">📧 Email</button>
          </div>
        </div>
        <p class="fs11 muted mb4">Generated at 5:30 PM, June 7, 2026</p>
        <div class="mb4"><label class="fs12 fw6 muted" style="display:block;margin-bottom:4px">📋 Today</label><textarea class="form-input" style="min-height:60px;padding:10px 14px;font-size:13px;line-height:1.6;width:100%">Fixed login page layout (AIPM-42). Implemented email rate limiting (AIPM-38). Code reviewed PR for board API.</textarea></div>
        <div class="mb4"><label class="fs12 fw6 muted" style="display:block;margin-bottom:4px">🚧 Blockers</label><textarea class="form-input" style="min-height:45px;padding:10px 14px;font-size:13px;line-height:1.6;width:100%">AIPM-21 blocked by AIPM-18 (waiting on DB migration).</textarea></div>
        <div class="mb4"><label class="fs12 fw6 muted" style="display:block;margin-bottom:4px">📅 Tomorrow</label><textarea class="form-input" style="min-height:45px;padding:10px 14px;font-size:13px;line-height:1.6;width:100%">Start 3-tier permission system (AIPM-35). Pair with Charlie on CI/CD setup.</textarea></div>
        <div class="divider mb4"></div>
        <h3 style="font-size:16px;margin-bottom:10px">Team Summary</h3>
        <textarea class="form-input" style="min-height:60px;padding:10px 14px;font-size:13px;line-height:1.6;width:100%">Team completed 4 issues today (12 SP). 2 PRs merged. Sprint 3: 60% complete. ⚠ 2 P0 bugs unassigned.</textarea>
      </div>
    </div>
  </div>

  <!-- Prompt modal -->
  <div id="prompt-modal" class="view-off" style="position:fixed;inset:0;z-index:999;display:flex;align-items:center;justify-content:center"><div style="position:absolute;inset:0;background:rgba(0,0,0,0.4)" onclick="document.getElementById('prompt-modal').classList.add('view-off')"></div><div class="card" style="position:relative;width:500px;box-shadow:var(--sh-d)"><div class="card-hd flex justify-between items-center"><h3>🤖 Generate Report</h3><button class="btn btn-g btn-xs" onclick="document.getElementById('prompt-modal').classList.add('view-off')">✕</button></div><div class="card-bd" style="padding:20px"><p class="fs12 muted mb4">Describe what you want the AI to focus on. Be specific about project, scope, or tone.</p><textarea class="form-input" style="min-height:80px;padding:10px 14px;font-size:13px;width:100%;margin-bottom:12px" placeholder="e.g. Focus on AIPM project only. Highlight P0 bugs. Keep it brief for daily standup.">Focus on TomatoHub Core Platform. Include Sprint 3 status and highlight blocked tasks.</textarea><div class="flex gap2 justify-between"><button class="btn btn-s" onclick="document.getElementById('prompt-modal').classList.add('view-off')">Cancel</button><button class="btn btn-b" onclick="document.getElementById('prompt-modal').classList.add('view-off')">🤖 Generate</button></div></div></div></div>

  <!-- Share modal — select system users -->
  <div id="share-modal" class="view-off" style="position:fixed;inset:0;z-index:999;display:flex;align-items:center;justify-content:center"><div style="position:absolute;inset:0;background:rgba(0,0,0,0.4)" onclick="document.getElementById('share-modal').classList.add('view-off')"></div><div class="card" style="position:relative;width:480px;box-shadow:var(--sh-d)"><div class="card-hd flex justify-between items-center"><h3>↗ Share Report</h3><button class="btn btn-g btn-xs" onclick="document.getElementById('share-modal').classList.add('view-off')">✕</button></div><div class="card-bd" style="padding:20px"><p class="fs12 muted mb4">Share this report with team members. They will receive a notification.</p><div class="form-grp mb4"><label class="form-label">Search users</label><input class="form-input" placeholder="Type a name..."></div>
    <div class="mb4" style="max-height:160px;overflow-y:auto;border:1px solid hsl(var(--e-d));border-radius:var(--r)">
      <label class="hover-row flex items-center gap3" style="cursor:pointer;display:flex;padding:8px 12px"><input type="checkbox" checked style="accent-color:hsl(var(--brand))"><div class="av av-sm">B</div><span class="fs13">Bob Wang</span><span class="fs11 muted">Developer</span></label>
      <label class="hover-row flex items-center gap3" style="cursor:pointer;display:flex;padding:8px 12px"><input type="checkbox" checked style="accent-color:hsl(var(--brand))"><div class="av av-sm">C</div><span class="fs13">Charlie Li</span><span class="fs11 muted">Developer</span></label>
      <label class="hover-row flex items-center gap3" style="cursor:pointer;display:flex;padding:8px 12px"><input type="checkbox" style="accent-color:hsl(var(--brand))"><div class="av av-sm" style="background:hsl(var(--s-s));color:hsl(var(--s))">D</div><span class="fs13">Diana Wu</span><span class="fs11 muted">QA Engineer</span></label>
      <label class="hover-row flex items-center gap3" style="cursor:pointer;display:flex;padding:8px 12px"><input type="checkbox" style="accent-color:hsl(var(--brand))"><div class="av av-sm" style="background:hsl(var(--w-s));color:hsl(var(--w))">E</div><span class="fs13">Eva Zhang</span><span class="fs11 muted">Designer</span></label>
    </div>
    <p class="fs11 muted mb4">Selected: <strong>Bob Wang, Charlie Li</strong> — they will be notified</p>
    <div class="flex gap2 justify-between"><button class="btn btn-s" onclick="document.getElementById('share-modal').classList.add('view-off')">Cancel</button><button class="btn btn-b" onclick="document.getElementById('share-modal').classList.add('view-off')">↗ Share</button></div>
  </div></div></div>

  <!-- Email modal -->
  <div id="emod2" class="view-off" style="position:fixed;inset:0;z-index:999;display:flex;align-items:center;justify-content:center"><div style="position:absolute;inset:0;background:rgba(0,0,0,0.4)" onclick="document.getElementById('emod2').classList.add('view-off')"></div><div class="card" style="position:relative;width:560px;max-height:90vh;overflow-y:auto;box-shadow:var(--sh-d)"><div class="card-hd flex justify-between items-center"><h3>📧 Send Email</h3><button class="btn btn-g btn-xs" onclick="document.getElementById('emod2').classList.add('view-off')">✕</button></div><div class="card-bd" style="padding:20px">
    <div class="form-grp mb4"><label class="form-label">To</label><input class="form-input" value="team@ai-pm.dev"></div>
    <div class="form-grp mb4"><label class="form-label">CC</label><input class="form-input" placeholder="manager@example.com"></div>
    <div class="form-grp mb4"><label class="form-label">Subject</label><input class="form-input" value="Daily Report — Alice · June 7, 2026"></div>
    <div class="form-grp mb4"><label class="form-label">Message <span class="fs11 muted">— editable</span></label><textarea class="form-input" style="min-height:180px;padding:12px 14px;font-size:13px;line-height:1.7;width:100%">Hi team,

