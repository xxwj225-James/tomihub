</div></div>

<div class="grid-aside mb4">
  <div class="flex gap4" style="flex-direction:column">
    <div class="card"><div class="card-hd flex justify-between items-center"><h3>My Tasks</h3><a href="#" class="fs12 brand" onclick="show('issues')">View all →</a></div><div class="card-bd-nopad">
      <div class="hover-row flex items-center gap3" onclick="show('issue-detail')" style="cursor:pointer"><span class="mono fs12 muted">AIPM-42</span><span class="flex-1 fs13 fw5">Fix login layout on mobile</span><span class="tag tag-hi">High</span><span class="av">T</span></div>
