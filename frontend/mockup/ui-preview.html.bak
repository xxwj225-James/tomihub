    <div class="hover-row flex items-center gap4" style="cursor:pointer"><div class="av" style="width:32px;height:32px;font-size:12px;background:hsl(var(--w-s));color:hsl(var(--w))">W2</div><div class="flex-1"><div class="fs13 fw6">Weekly Report — Bob · Week 23</div><div class="fs11 muted">Shared with you · Jun 1 <span style="color:hsl(var(--brand));font-weight:600">🆕 New</span></div></div><span class="tag tag-med">Weekly</span><button class="btn btn-s btn-xs">View</button></div>
    <div class="hover-row flex items-center gap4" style="cursor:pointer"><div class="av" style="width:32px;height:32px;font-size:12px;background:hsl(var(--s-s));color:hsl(var(--s))">S3</div><div class="flex-1"><div class="fs13 fw6">Sprint 2 Review — Alice</div><div class="fs11 muted">Shared with team · Jun 1</div></div><span class="tag tag-b">Sprint</span><button class="btn btn-s btn-xs">View</button><button class="btn btn-g btn-xs">Export</button></div>
