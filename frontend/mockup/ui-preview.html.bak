<!-- ─── CHAT OPS ─── -->
<div id="v-integrations" class="view-off">
<div class="ch"><h2>ChatOps</h2><span class="fs12 muted">Bot setup — connect chat platforms so members can manage issues from Feishu / WeCom</span></div>
<div class="cb"><div style="max-width:800px">

  <div class="card mb4">
    <div class="card-hd"><h3>Platform Connections</h3></div>
    <div class="card-bd" style="padding:16px 20px">

      <p class="fs12 mb4" style="padding:10px 14px;background:hsl(var(--brand-s));border-radius:var(--r);line-height:1.6">
        <strong>How it works:</strong> Admin connects the Bot once per platform. Members then <strong>bind their own chat account</strong> in Profile settings. Once bound, members can assign issues, check status, and view project health directly from chat — <strong>no approval needed</strong>. Only AI Agent autonomous writes require HITL confirmation.
      </p>

      <!-- Feishu -->
      <div class="mb4" style="border:1px solid hsl(var(--e-d));border-radius:var(--r);padding:14px 16px">
        <div class="flex justify-between items-center mb4">
          <div class="flex items-center gap3"><span style="font-size:24px">🟦</span><div><div class="fs14 fw6">Feishu (Lark)</div><span class="fs11 muted">Bot connected · 8 members bound</span></div></div>
          <span class="tag tag-lo">Active</span>
        </div>
        <div class="grid2 mb4">
          <div class="form-grp"><label class="form-label">App ID <span class="fs11 muted">— from open.feishu.cn → App Credentials</span></label><input class="form-input" value="cli_a7b3c9d1"></div>
          <div class="form-grp"><label class="form-label">App Secret</label><input class="form-input" type="password" value="••••••••••••••••"></div>
        </div>
        <div class="form-grp mb4"><label class="form-label">Webhook URL <span class="fs11 muted">— paste into Feishu App → Event Subscriptions</span></label><input class="form-input mono" value="https://api.ai-pm.app/webhooks/feishu/events" readonly style="opacity:0.7"></div>
        <div class="flex gap2"><button class="btn btn-s btn-xs">Test</button><button class="btn btn-g btn-xs danger">Disconnect</button></div>
      </div>

      <!-- WeCom -->
      <div style="border:1px solid hsl(var(--e-d));border-radius:var(--r);padding:14px 16px">
        <div class="flex justify-between items-center mb4">
          <div class="flex items-center gap3"><span style="font-size:24px">🟢</span><div><div class="fs14 fw6">WeCom (Enterprise WeChat)</div><span class="fs11 muted">Not configured</span></div></div>
          <span class="tag tag-med">Inactive</span>
        </div>
        <div class="grid2 mb4">
          <div class="form-grp"><label class="form-label">Corp ID <span class="fs11 muted">— from WeCom Admin Console</span></label><input class="form-input" placeholder="ww_xxxxxxxxxxxxx"></div>
          <div class="form-grp"><label class="form-label">Agent ID</label><input class="form-input" placeholder="1000001"></div>
        </div>
        <div class="form-grp mb4"><label class="form-label">App Secret</label><input class="form-input" type="password" placeholder="From WeCom App settings"></div>
        <button class="btn btn-b btn-xs">Connect</button>
      </div>

    </div>
  </div>

  <!-- Push Events -->
  <div class="card mb4">
    <div class="card-hd"><h3>Push Events to Chat</h3></div>
    <div class="card-bd" style="padding:16px 20px">
      <p class="fs12 muted mb4">When these events happen, the Bot sends a message to the relevant member in their bound chat app.</p>
      <div class="grid2 fs12" style="gap:6px">
        <label class="flex items-center gap2"><input type="checkbox" checked style="accent-color:hsl(var(--brand))">Issue assigned to me</label>
        <label class="flex items-center gap2"><input type="checkbox" checked style="accent-color:hsl(var(--brand))">@mentioned in a comment</label>
        <label class="flex items-center gap2"><input type="checkbox" checked style="accent-color:hsl(var(--brand))">Report shared with me</label>
        <label class="flex items-center gap2"><input type="checkbox" checked style="accent-color:hsl(var(--brand))">AI risk / health alert</label>
        <label class="flex items-center gap2"><input type="checkbox" style="accent-color:hsl(var(--brand))">Sprint deadline approaching</label>
        <label class="flex items-center gap2"><input type="checkbox" checked style="accent-color:hsl(var(--brand))">AI Agent HITL confirmation needed</label>
      </div>
    </div>
  </div>

  <!-- SMTP Config -->
  <div class="card mb4">
    <div class="card-hd"><h3>Email (SMTP)</h3></div>
    <div class="card-bd" style="padding:16px 20px">
      <p class="fs12 muted mb4">Configure the email server for sending verification codes and notifications. Changes take effect immediately — no restart needed.</p>
      <div class="flex gap2 mb4">
        <button class="btn btn-s btn-xs" style="background:hsl(var(--brand-s));color:hsl(var(--brand));font-weight:600">Custom</button>
        <button class="btn btn-s btn-xs">Microsoft 365</button>
        <button class="btn btn-s btn-xs">Google Workspace</button>
        <button class="btn btn-s btn-xs">Tencent Exmail</button>
        <button class="btn btn-s btn-xs">NetEase Exmail</button>
        <button class="btn btn-s btn-xs">Ali Mail</button>
      </div>
      <div class="grid2 mb4">
        <div class="form-grp"><label class="form-label">SMTP Host</label><input class="form-input" value="smtp.example.com" placeholder="smtp.office365.com"></div>
        <div class="form-grp"><label class="form-label">Port</label><input class="form-input" value="587" type="number"></div>
      </div>
      <div class="grid2 mb4">
        <div class="form-grp"><label class="form-label">Username / Email</label><input class="form-input" value="noreply@tomato-hub.com" placeholder="noreply@your-company.com"></div>
        <div class="form-grp"><label class="form-label">Password / App Password</label><input class="form-input" type="password" value="••••••••"></div>
      </div>
      <div class="grid2 mb4">
        <div class="form-grp"><label class="form-label">Sender Name</label><input class="form-input" value="TomatoHub"></div>
        <div class="form-grp"><label class="form-label flex items-center gap-2 pt-5"><input type="checkbox" checked style="accent-color:hsl(var(--brand))"> Enable STARTTLS</label></div>
      </div>
      <div class="flex gap2"><button class="btn btn-b btn-xs">Save</button><button class="btn btn-s btn-xs">Test Connection</button></div>
    </div>
  </div>

  <!-- HITL channels -->
  <div class="card">
    <div class="card-hd"><h3>HITL Confirmation Channels</h3></div>
    <div class="card-bd" style="padding:16px 20px">
      <p class="fs12 muted mb4">When an <strong>AI Agent</strong> (Claude/Cursor) requests a write operation, the confirmation request is sent to:</p>
      <select class="form-select" style="width:100%"><option>Web + Chat (Feishu/WeCom) + VSCode</option><option>Web only</option><option>Web + Chat</option></select>
    </div>
  </div>

</div></div></div>

