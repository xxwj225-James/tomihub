    <div class="flex gap2 justify-between"><button class="btn btn-s" onclick="document.getElementById('emod2').classList.add('view-off')">Cancel</button><button class="btn btn-b" onclick="document.getElementById('emod2').classList.add('view-off')">📧 Send</button></div>
  </div></div></div>

  <!-- ═══ Archive Section ═══ -->
  <div class="card"><div class="card-hd"><div class="flex items-center gap4"><h3>Archive</h3><div class="flex gap1"><button class="btn btn-s btn-xs" style="background:hsl(var(--brand-s));color:hsl(var(--brand));font-weight:600">My Reports</button><button class="btn btn-s btn-xs">Shared With Me</button></div></div></div><div class="card-bd-nopad">
    <div class="flex gap2 px3 py2"><button class="btn btn-s btn-xs" style="background:hsl(var(--brand-s));color:hsl(var(--brand));font-weight:600">All</button><button class="btn btn-s btn-xs">Daily</button><button class="btn btn-s btn-xs">Weekly</button><button class="btn btn-s btn-xs">Monthly</button><button class="btn btn-s btn-xs">Sprint</button></div>
