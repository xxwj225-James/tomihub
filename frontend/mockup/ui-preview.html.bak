      <div class="flex-1"><div class="fs13 fw6">Expired: delete_issue("AIPM-55")</div><div class="fs11 muted">Cursor · No response within 5 min · Jun 6, 2:15 PM</div></div>
      <span class="tag tag-med">Expired</span>
    </div>
    <div class="hover-row flex items-center gap4">
      <div style="width:32px;height:32px;border-radius:50%;background:hsl(var(--s-s));color:hsl(var(--s));display:flex;align-items:center;justify-content:center;font-size:14px">✓</div>
      <div class="flex-1"><div class="fs13 fw6">Approved: comment_issue("AIPM-38", "Rate limit implemented, please review")</div><div class="fs11 muted">Claude Code · Auto-approved (low risk) · Jun 6, 10:00 AM</div></div>
      <span class="tag tag-lo">Approved</span>
