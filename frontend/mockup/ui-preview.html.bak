  },
  'login': {
    answer: '<h3 style="margin-bottom:8px">Login System Overview</h3><p style="line-height:1.7;margin-bottom:12px">The login system uses <strong>JWT RS256</strong> asymmetric tokens with a <strong>two-stage token model</strong> for multi-tenant support.</p><p style="line-height:1.7;margin-bottom:6px"><strong>🔐 Authentication Flow:</strong><br>1. User enters email+password → Pre-Tenant Token (scope=tenant_selection)<br>2. User selects workspace → Full-Scope Token (scope=business)</p><p style="line-height:1.7;margin-bottom:6px"><strong>📱 Current Issues:</strong><br>· AIPM-42: Login page layout broken on mobile<br>· AIPM-38: Email verification rate limiting needed</p><p style="line-height:1.7;margin-top:12px"><strong>📚 Documentation:</strong><br>· <a href="#" style="color:hsl(var(--brand))">Login Module Design</a><br>· <a href="#" style="color:hsl(var(--brand))">API Authentication Guide</a></p>',
    sources: [
      {type:'wiki',title:'Login Module Design'},
      {type:'wiki',title:'API Authentication Guide'},
      {type:'issue',key:'AIPM-42',title:'Fix login page layout on mobile'},
      {type:'issue',key:'AIPM-38',title:'Email verification rate limiting'},
    ],
    related: ['How to reset password?','JWT token expiration handling','Multi-tenant workspace switching flow']
  },
  'permission': {
    answer: '<h3 style="margin-bottom:8px">Permission System</h3><p style="line-height:1.7;margin-bottom:12px">TomatoHub uses a <strong>three-tier permission model</strong>: Global → Project → Issue Security Level.</p><p style="line-height:1.7;margin-bottom:6px"><strong>👑 Roles:</strong> Tenant Owner (full access), Tenant Admin, Project Lead, Developer, Reviewer, Viewer.</p><p style="line-height:1.7;margin-bottom:6px"><strong>📋 Key Permission Codes:</strong> 25 codes across GLOBAL (7) and PROJECT (18) categories.</p><p style="line-height:1.7;margin-top:12px"><strong>📚 Documentation:</strong><br>· <a href="#" style="color:hsl(var(--brand))">Permission System Overview</a> (Mobile App Redesign project)<br>· <a href="#" style="color:hsl(var(--brand))">Architecture Decision Records</a></p>',
    sources: [
      {type:'wiki',title:'Permission System Overview'},
      {type:'wiki',title:'Architecture Decision Records'},
      {type:'issue',key:'AIPM-35',title:'3-tier permission system'},
    ],
    related: ['How to create custom roles?','Project-level vs Global permissions','Issue Security Level setup']
  }
};

function closeSearch() {
  document.getElementById('search-input').value = '';
  document.getElementById('search-results').classList.add('view-off');
  document.getElementById('search-default').classList.remove('view-off');
  document.getElementById('search-quick-results').classList.add('view-off');
  document.getElementById('search-ai-results').classList.add('view-off');
  document.getElementById('search-empty').classList.add('view-off');
  document.getElementById('search-loading').classList.add('view-off');
}

function handleSearchInput(query) {
  if (!query || query.trim().length === 0) {
    closeSearch();
    return;
  }
  document.getElementById('search-results').classList.remove('view-off');
  document.getElementById('search-default').classList.add('view-off');
  showQuickResults(query);
}

function handleSearch(query, isAI) {
  if (!query || query.trim().length === 0) return;
  document.getElementById('search-results').classList.remove('view-off');
  document.getElementById('search-default').classList.add('view-off');
  if (isAI) {
    showAIResults(query);
  } else {
    showQuickResults(query);
  }
}

function showQuickResults(query) {
  var q = query.toLowerCase().trim();
  document.getElementById('search-ai-results').classList.add('view-off');
  document.getElementById('search-loading').classList.add('view-off');

  // Filter results
  var matchedIssues = MOCK_DATA.issues.filter(function(i){return i.title.toLowerCase().indexOf(q)>-1||i.key.toLowerCase().indexOf(q)>-1});
  var matchedWiki = MOCK_DATA.wiki.filter(function(w){return w.title.toLowerCase().indexOf(q)>-1||w.category.toLowerCase().indexOf(q)>-1});
  var matchedSprints = MOCK_DATA.sprints.filter(function(s){return s.name.toLowerCase().indexOf(q)>-1});

  if (matchedIssues.length===0 && matchedWiki.length===0 && matchedSprints.length===0) {
    document.getElementById('search-quick-results').classList.add('view-off');
    document.getElementById('search-empty').classList.remove('view-off');
    document.getElementById('search-empty-query').textContent = query;
    return;
  }

  document.getElementById('search-empty').classList.add('view-off');
  var panel = document.getElementById('search-quick-results');
  panel.classList.remove('view-off');

  var html = '';
  if (matchedIssues.length > 0) {
    html += '<div style="padding:10px 16px 4px;font-size:11px;font-weight:600;color:hsl(var(--ink-muted));text-transform:uppercase;letter-spacing:0.04em">Issues ('+matchedIssues.length+')</div>';
    matchedIssues.slice(0,5).forEach(function(i){
      var priClass = i.priority==='High'?'tag-hi':(i.priority==='Medium'?'tag-med':'tag-lo');
      html += '<div class="hover-row flex items-center gap-3" style="cursor:pointer;padding:10px 16px" onclick="show(\'issue-detail\')"><span class="mono fs12" style="color:hsl(var(--ink-muted))">'+i.key+'</span><span class="flex-1 fs13 fw5">'+highlightMatch(i.title,q)+'</span><span class="tag '+priClass+'">'+i.priority+'</span><span class="fs11" style="color:hsl(var(--ink-muted))">'+i.project+'</span></div>';
    });
    if (matchedIssues.length > 5) html += '<div style="padding:6px 16px;font-size:11px;color:hsl(var(--ink-muted))">+ '+(matchedIssues.length-5)+' more issues</div>';
  }
  if (matchedWiki.length > 0) {
    html += '<div style="padding:10px 16px 4px;font-size:11px;font-weight:600;color:hsl(var(--ink-muted));text-transform:uppercase;letter-spacing:0.04em;border-top:1px solid hsl(var(--edge-default))">Knowledge ('+matchedWiki.length+')</div>';
    matchedWiki.slice(0,3).forEach(function(w){
      html += '<div class="hover-row flex items-center gap-3" style="cursor:pointer;padding:10px 16px" onclick="show(\'wiki-editor\')"><span style="font-size:16px">📄</span><span class="flex-1 fs13 fw5">'+highlightMatch(w.title,q)+'</span><span class="fs11" style="color:hsl(var(--ink-muted))">'+w.project+' · '+w.category+'</span></div>';
    });
  }
  if (matchedSprints.length > 0) {
    html += '<div style="padding:10px 16px 4px;font-size:11px;font-weight:600;color:hsl(var(--ink-muted));text-transform:uppercase;letter-spacing:0.04em;border-top:1px solid hsl(var(--edge-default))">Sprints ('+matchedSprints.length+')</div>';
    matchedSprints.forEach(function(s){
      html += '<div class="hover-row flex items-center gap-3" style="cursor:pointer;padding:10px 16px" onclick="show(\'sprints\')"><span style="font-size:16px">🔄</span><span class="flex-1 fs13 fw5">'+highlightMatch(s.name,q)+'</span><div class="progress" style="width:80px"><div class="progress-bar brand" style="width:'+s.progress+'%"></div></div><span class="fs11" style="color:hsl(var(--ink-muted))">'+s.status+'</span></div>';
    });
  }
  panel.innerHTML = html;
}

function showAIResults(query) {
  var q = query.toLowerCase().trim();
  document.getElementById('search-quick-results').classList.add('view-off');
  document.getElementById('search-empty').classList.add('view-off');
  document.getElementById('search-ai-results').classList.add('view-off');
  document.getElementById('search-loading').classList.remove('view-off');

  // Simulate AI progress
  var bar = document.getElementById('ai-progress-bar');
  bar.style.width = '0%';
  setTimeout(function(){bar.style.width='30%'},300);
  setTimeout(function(){bar.style.width='60%'},800);
  setTimeout(function(){bar.style.width='90%'},1500);

  setTimeout(function(){
    document.getElementById('search-loading').classList.add('view-off');
    var panel = document.getElementById('search-ai-results');
    panel.classList.remove('view-off');

    // Find best match
    var aiData = null;
    if (q.indexOf('ci/cd')>-1||q.indexOf('ci')>-1||q.indexOf('cd')>-1||q.indexOf('pipeline')>-1) aiData = AI_ANSWERS['ci/cd'];
    else if (q.indexOf('login')>-1||q.indexOf('登')>-1) aiData = AI_ANSWERS['login'];
    else if (q.indexOf('permission')>-1||q.indexOf('权限')>-1) aiData = AI_ANSWERS['permission'];
    else aiData = AI_ANSWERS['ci/cd']; // default

    var html = '';
    html += '<div style="margin-bottom:16px">'+aiData.answer+'</div>';
    if (aiData.sources && aiData.sources.length>0) {
      html += '<div style="border-top:1px solid hsl(var(--edge-default));padding-top:12px;margin-bottom:12px"><span class="fs11 muted fw6">📎 Sources:</span></div>';
      aiData.sources.forEach(function(s){
        html += '<div class="fs12" style="margin-bottom:4px">· ['+(s.type==='wiki'?'Wiki':'Issue')+'] <a href="#" style="color:hsl(var(--brand))">'+s.title+(s.key?' ('+s.key+')':'')+'</a></div>';
      });
    }
    if (aiData.related && aiData.related.length>0) {
      html += '<div style="border-top:1px solid hsl(var(--edge-default));padding-top:12px;margin-top:12px"><span class="fs11 muted fw6">💡 Related Questions:</span></div>';
      aiData.related.forEach(function(r){
        html += '<div class="fs12" style="margin:4px 0;cursor:pointer;color:hsl(var(--brand))" onclick="document.getElementById(\'search-input\').value=\''+r+'\';handleSearch(\''+r+'\',true)">· '+r+'</div>';
      });
    }
    html += '<div style="border-top:1px solid hsl(var(--edge-default));padding-top:12px;margin-top:16px"><span class="fs11 muted">Not finding what you need? </span><a href="#" class="fs12 brand fw6">🔍 Search the web</a></div>';
    panel.innerHTML = html;
  }, 2000);
}

function highlightMatch(text, query) {
  var idx = text.toLowerCase().indexOf(query.toLowerCase());
  if (idx === -1) return text;
  return text.substring(0,idx)+'<strong style="color:hsl(var(--brand))">'+text.substring(idx,idx+query.length)+'</strong>'+text.substring(idx+query.length);
}
</script>

</body>
</html>
