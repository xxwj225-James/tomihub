<!-- Notification panel — slides out from sidebar -->
<div id="notif-panel" class="view-off card" style="position:fixed;top:12px;left:232px;width:420px;max-height:560px;overflow-y:auto;z-index:998;box-shadow:var(--sh-d)"><div class="card-hd flex justify-between items-center"><h3>Notifications</h3><div class="flex gap2"><button class="btn btn-g btn-xs fs11">Mark all read</button><button class="btn btn-g btn-xs" onclick="document.getElementById(`notif-panel`).classList.add(`view-off`)">x</button></div></div><div class="card-bd-nopad">
<div style="padding:8px 14px;background:hsl(var(--w-s));border-bottom:1px solid hsl(var(--e-d));font-size:11px;font-weight:600;color:hsl(var(--w))">Needs your approval</div>
<div style="padding:12px 14px;border-bottom:1px solid hsl(var(--e-d));border-left:3px solid hsl(var(--w))"><div class="flex items-start gap3 mb4"><span style="font-size:18px">AI</span><div class="flex-1"><div class="fs13 fw6">Claude wants to update AIPM-42</div><div class="fs11 muted mt4">Status to In Review · Assignee to Bob</div><div class="fs11 muted">2 min ago · Auto-deny in 4:30</div></div></div><div class="flex gap2"><button class="btn btn-b btn-xs" style="padding:3px 10px;font-size:11px">Approve</button><button class="btn btn-s btn-xs" style="padding:3px 10px;font-size:11px">Deny</button></div></div>
<div style="padding:12px 14px;border-left:3px solid hsl(var(--d))"><div class="flex items-start gap3 mb4"><span style="font-size:18px">AI</span><div class="flex-1"><div class="fs13 fw6">Claude wants to move 3 issues to Sprint 4</div><div class="fs11 muted mt4">AIPM-45, 48, 46 to Sprint 4</div><div class="fs11 muted">5 min ago · Auto-deny in 2:30</div></div></div><div class="flex gap2"><button class="btn btn-b btn-xs" style="padding:3px 10px;font-size:11px">Approve</button><button class="btn btn-s btn-xs" style="padding:3px 10px;font-size:11px">Deny</button></div></div>
<div style="padding:8px 14px;background:hsl(var(--sf-h));font-size:11px;color:hsl(var(--i-m))">Earlier</div>
<div class="hover-row flex items-start gap3" style="cursor:pointer;padding:12px 14px" onclick="show(`issue-detail`)"><span style="font-size:18px">Task</span><div class="flex-1"><div class="fs13 fw6">Bob assigned AIPM-42 to you</div><div class="fs11 muted mt4">5 min ago</div></div></div>
<div class="hover-row flex items-start gap3" style="cursor:pointer;padding:12px 14px" onclick="show(`reports`)"><span style="font-size:18px">Report</span><div class="flex-1"><div class="fs13 fw6">Bob shared a Weekly Report</div><div class="fs11 muted mt4">1 hour ago</div></div></div>
<div class="hover-row flex items-start gap3" style="cursor:pointer;padding:12px 14px"><span style="font-size:18px">AI</span><div class="flex-1"><div class="fs13 fw6">AI Health analysis complete</div><div class="fs11 muted mt4">2 hours ago</div></div></div>
<div class="hover-row flex items-start gap3" style="cursor:pointer;padding:12px 14px" onclick="show(`issue-detail`)"><span style="font-size:18px">Comment</span><div class="flex-1"><div class="fs13 fw6">Charlie mentioned you in AIPM-38</div><div class="fs11 muted mt4">3 hours ago</div></div></div>
</div></div>

<!-- ══════════════ CONTENT AREA ══════════════ -->
<main class="ct">

<!-- ─── DASHBOARD ─── -->
<div id="v-dash">
<div class="ch"><h2>Home</h2><div class="flex gap2 items-center"><span class="fs12 muted">Role: Project Manager</span><button class="btn btn-b fs12" onclick="show('issue-create')">+ New Project</button></div></div>
<div class="cb">
<!-- Search Bar — interactive -->
<div class="card mb4" style="padding:0">
  <div class="flex items-center gap-2" style="padding:8px 16px">
    <svg style="width:20px;height:20px;flex-shrink:0;color:hsl(var(--ink-muted))" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
    <input id="search-input" class="form-input flex-1" style="border:none;padding:10px 0;font-size:14px;box-shadow:none"
      placeholder="Search across your projects — issues, docs, sprints..."
      oninput="handleSearchInput(this.value)"
      onkeydown="if(event.key==='Enter')handleSearch(this.value, false)">
    <button class="btn btn-s btn-xs" onclick="handleSearch(document.getElementById('search-input').value, true)" style="font-weight:500">🤖 AI Search</button>
  </div>
  <!-- Default: recent searches -->
  <div id="search-default" style="border-top:1px solid hsl(var(--e-d));padding:12px 16px">
    <p class="fs11 muted fw6 mb4" style="text-transform:uppercase;letter-spacing:0.04em">Recent searches · Try:</p>
    <div class="flex gap-2 flex-wrap">
      <span class="tag tag-b" style="cursor:pointer" onclick="document.getElementById('search-input').value='CI/CD pipeline';handleSearch('CI/CD pipeline',false)">CI/CD pipeline</span>
      <span class="tag tag-b" style="cursor:pointer" onclick="document.getElementById('search-input').value='login bug';handleSearch('login bug',false)">login bug</span>
      <span class="tag tag-b" style="cursor:pointer" onclick="document.getElementById('search-input').value='API documentation';handleSearch('API documentation',false)">API documentation</span>
      <span class="tag tag-b" style="cursor:pointer" onclick="document.getElementById('search-input').value='sprint review';handleSearch('sprint review',false)">sprint review</span>
      <span class="tag tag-b" style="cursor:pointer" onclick="document.getElementById('search-input').value='permission system';handleSearch('permission system',false)">permission system</span>
    </div>
  </div>

  <!-- Results area — max-height + scroll + close button -->
  <div id="search-results" class="view-off" style="border-top:1px solid hsl(var(--e-d));max-height:420px;overflow-y:auto;position:relative">
    <div style="position:sticky;top:0;right:0;z-index:1;display:flex;justify-content:flex-end;padding:4px 8px;background:hsl(var(--surface-card));border-bottom:1px solid hsl(var(--edge-default))">
      <button class="btn btn-g btn-xs" onclick="closeSearch()" title="Close search">✕ Close</button>
    </div>
    <div id="search-quick-results" class="view-off" style="padding:0"></div>
    <div id="search-ai-results" class="view-off" style="padding:16px 20px"></div>
    <div id="search-empty" class="view-off" style="padding:20px;text-align:center">
      <p class="fs14 text-ink-muted">No results found for "<span id="search-empty-query"></span>"</p>
      <p class="fs12 text-ink-muted mt-2">Try different keywords or use 🤖 AI Deep search</p>
    </div>
    <div id="search-loading" class="view-off" style="padding:20px;text-align:center">
      <p class="fs14 text-ink-muted">🤖 AI is analyzing...</p>
      <div class="progress mt-3" style="width:200px;margin:0 auto"><div id="ai-progress-bar" class="progress-bar brand" style="width:0%;transition:width 0.5s"></div></div>
    </div>
  </div>
</div>

<div class="stat-row">
  <div class="sc"><div class="lbl">My Tasks</div><div class="val brand">5</div><div class="sub">3 high · 2 medium</div></div>
  <div class="sc" onclick="document.getElementById('inprogress-expand').classList.toggle('view-off');this.querySelector('.expand-icon').classList.toggle('rotate-90')" style="cursor:pointer">
    <div class="lbl flex items-center gap2">In Progress <span class="expand-icon fs11" style="transition:transform 0.2s">▶</span></div><div class="val warn">3</div><div class="sub">Click to expand</div>
  </div>
  <div class="sc" onclick="document.getElementById('completed-expand').classList.toggle('view-off');this.querySelector('.expand-icon2').classList.toggle('rotate-90')" style="cursor:pointer">
    <div class="lbl flex items-center gap2">Completed <span class="expand-icon2 fs11" style="transition:transform 0.2s">▶</span></div><div class="val success-text">12</div><div class="sub">4 this week · Click to expand</div>
  </div>
  <div class="sc ai-glow"><div class="lbl"><span class="pulse"></span>My Health Score</div><div class="val brand">78</div><div class="sub">At Risk · 2 warnings</div></div>
</div>

