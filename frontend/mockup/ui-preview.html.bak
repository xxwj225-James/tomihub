<!DOCTYPE html>
<html lang="en" data-theme="pipeline">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TomatoHub UI Mockup — Full Coverage</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

/* ═══ THEMES ═══ */
:root,[data-theme="pipeline"]{--brand:237 47% 57%;--brand-h:237 47% 50%;--brand-s:237 100% 98%;--brand-t:0 0% 100%;--sf-a:240 3% 98%;--sf-c:0 0% 100%;--sf-h:240 5% 96%;--sf-s:240 4% 14%;--i-p:240 4% 12%;--i-s:240 3% 38%;--i-m:240 3% 55%;--i-sb:240 3% 55%;--i-sba:0 0% 100%;--e-d:240 4% 92%;--e-h:240 4% 84%;--e-s:240 3% 18%;--d:0 65% 48%;--d-s:0 70% 97%;--s:142 45% 40%;--s-s:140 50% 97%;--w:32 85% 44%;--w-s:32 90% 96%;--r:0.5rem;--sh:0 0 0 1px rgba(0,0,0,.03),0 1px 3px rgba(0,0,0,.04);--sh-h:0 0 0 1px rgba(0,0,0,.04),0 8px 24px rgba(0,0,0,.08);--sh-d:0 0 0 1px rgba(0,0,0,.05),0 24px 60px rgba(0,0,0,.15);--f:'Inter',system-ui,sans-serif}
[data-theme="hub"]{--brand:214 89% 52%;--brand-h:214 89% 45%;--brand-s:214 100% 97%;--sf-a:214 25% 95%;--sf-s:0 0% 100%;--sf-h:214 25% 93%;--i-p:214 25% 12%;--i-s:214 10% 38%;--i-m:214 8% 56%;--i-sb:214 10% 40%;--i-sba:214 90% 42%;--e-d:214 18% 88%;--e-h:214 18% 78%;--e-s:214 20% 90%;--r:0.625rem;--sh:0 1px 3px rgba(0,0,0,.06)}
[data-theme="canvas"]{--brand:210 80% 45%;--brand-h:210 80% 38%;--brand-s:210 100% 96%;--sf-a:0 0% 98%;--sf-s:0 0% 100%;--sf-h:0 0% 95%;--i-p:0 0% 10%;--i-s:0 0% 34%;--i-m:0 0% 50%;--i-sb:0 0% 38%;--i-sba:210 80% 40%;--e-d:0 0% 86%;--e-h:0 0% 74%;--e-s:0 0% 92%;--r:0.25rem;--sh:0 1px 2px rgba(0,0,0,.08)}
[data-theme="quantum"]{--brand:80 55% 48%;--brand-h:80 60% 55%;--brand-s:80 50% 10%;--brand-t:80 5% 6%;--sf-a:80 3% 11%;--sf-c:80 3% 13%;--sf-h:80 3% 16%;--sf-s:80 5% 9%;--i-p:80 8% 90%;--i-s:80 6% 68%;--i-m:80 4% 48%;--i-sb:80 5% 52%;--i-sba:80 55% 62%;--e-d:80 3% 20%;--e-h:80 3% 28%;--e-s:80 3% 16%;--r:0;--sh:0 0 0 1px hsl(80 3% 18%)}

/* ═══ RESET & BASE ═══ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:var(--f);font-size:14px;background:hsl(var(--sf-a));color:hsl(var(--i-p));-webkit-font-smoothing:antialiased}
svg{display:block}button{font:inherit;cursor:pointer;border:none;background:none}
a{color:inherit;text-decoration:none}

/* ═══ LAYOUT ═══ */
.layout{display:flex;height:100vh;overflow:hidden}
.sb{width:224px;flex-shrink:0;display:flex;flex-direction:column;background:hsl(var(--sf-s));border-right:1px solid hsl(var(--e-s));overflow-y:auto}
.sb-logo{display:flex;align-items:center;gap:10px;padding:0 16px;height:52px;border-bottom:1px solid hsl(var(--e-s))}
.sb-logo-icon{width:26px;height:26px;border-radius:6px;background:hsl(var(--brand));display:flex;align-items:center;justify-content:center;color:hsl(var(--brand-t));font-weight:700;font-size:12px;flex-shrink:0}
.sb-logo-text{font-weight:600;font-size:14px;color:hsl(var(--i-sba));letter-spacing:-0.01em}
.sb-nav{flex:1;padding:8px;display:flex;flex-direction:column;gap:1px}
.sb-sep{margin-top:12px}
.sb-label{padding:6px 10px 4px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:hsl(var(--i-sb)/0.45)}
.nav{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:var(--r);font-size:13px;color:hsl(var(--i-sb));transition:all 0.12s}
.nav:hover{background:hsl(var(--sf-h)/0.08);color:hsl(var(--i-sba))}
.nav.act{background:hsl(var(--sf-s)/0.3);color:hsl(var(--i-sba));font-weight:500}
.nav svg{width:16px;height:16px;flex-shrink:0}
.nav .badge{margin-left:auto;font-size:10px;padding:1px 6px;border-radius:99px;background:hsl(var(--brand));color:hsl(var(--brand-t));font-weight:600}
.sb-foot{padding:8px;border-top:1px solid hsl(var(--e-s))}
.sb-foot-btn{display:flex;align-items:center;gap:10px;width:100%;padding:7px 10px;border-radius:var(--r);font-size:12px;color:hsl(var(--i-sb));transition:all 0.12s}
.sb-foot-btn:hover{background:hsl(var(--sf-h)/0.08);color:hsl(var(--i-sba))}
.sb-foot-btn svg{width:16px;height:16px;flex-shrink:0}
.theme-row{display:flex;gap:4px;padding:6px 10px}
.tdot{width:18px;height:18px;border-radius:50%;border:2px solid transparent;cursor:pointer;flex-shrink:0;transition:all 0.15s}
.tdot:hover{border-color:hsl(var(--i-sba));transform:scale(1.15)}
.tdot.act{border-color:hsl(var(--i-sba));box-shadow:0 0 0 2px hsl(var(--i-sba)/.2)}

/* ═══ CONTENT ═══ */
.ct{flex:1;overflow-y:auto;background:hsl(var(--sf-a))}
.ch{border-bottom:1px solid hsl(var(--e-d));padding:14px 24px;background:hsl(var(--sf-c));display:flex;align-items:center;justify-content:space-between;min-height:53px}
.ch h2{font-size:16px;font-weight:600}.ch .bc{font-size:12px;color:hsl(var(--i-m))}
.cb{padding:24px;max-width:1400px}

/* ═══ CARDS ═══ */
.card{background:hsl(var(--sf-c));border:1px solid hsl(var(--e-d));border-radius:var(--r);box-shadow:var(--sh);transition:box-shadow 0.2s}
.card:hover{box-shadow:var(--sh-h)}
.card-hd{padding:14px 18px;border-bottom:1px solid hsl(var(--e-d))}
.card-hd h3{font-size:14px;font-weight:600}
.card-bd{padding:16px 18px}
.card-bd-nopad{padding:0}

/* ═══ BUTTONS ═══ */
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:var(--r);font-size:13px;font-weight:500;transition:all 0.15s;white-space:nowrap}
.btn-b{background:hsl(var(--brand));color:hsl(var(--brand-t))}.btn-b:hover{background:hsl(var(--brand-h))}
.btn-s{border:1px solid hsl(var(--e-d));color:hsl(var(--i-s))}.btn-s:hover{background:hsl(var(--sf-h));color:hsl(var(--i-p))}
.btn-g{color:hsl(var(--i-s))}.btn-g:hover{background:hsl(var(--sf-h))}
.btn-xs{padding:4px 10px;font-size:11px}

.danger{color:hsl(var(--d))}.dg-soft{background:hsl(var(--d-s))}.warn{color:hsl(var(--w))}.warn-soft{background:hsl(var(--w-s))}.success-text{color:hsl(var(--s))}.succ-soft{background:hsl(var(--s-s))}.brand{color:hsl(var(--brand))}.brand-soft{background:hsl(var(--brand-s))}
.muted{color:hsl(var(--i-m))}.muted-text{color:hsl(var(--i-m))}.pri{color:hsl(var(--i-p))}.sec{color:hsl(var(--i-s))}

/* ═══ UTILITY ═══ */
.flex{display:flex}.items-center{align-items:center}.gap2{gap:8px}.gap3{gap:12px}.gap4{gap:16px}.justify-between{justify-content:space-between}.flex-1{flex:1}.shrink{flex-shrink:0}.text-r{text-align:right}.text-c{text-align:center}
.mono{font-family:'JetBrains Mono',monospace}.fs11{font-size:11px}.fs12{font-size:12px}.fs13{font-size:13px}.fs14{font-size:14px}.fw6{font-weight:600}.fw5{font-weight:500}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid-aside{display:grid;grid-template-columns:280px 1fr;gap:16px}
.mb4{margin-bottom:16px}.mt4{margin-top:16px}.p2{padding:8px}.p3{padding:12px}.p4{padding:16px}.px3{padding-left:12px;padding-right:12px}.py2{padding-top:8px;padding-bottom:8px}
.tag{display:inline-block;font-size:11px;padding:2px 8px;border-radius:99px;font-weight:500;white-space:nowrap}
.tag-hi{background:hsl(var(--d-s));color:hsl(var(--d))}.tag-med{background:hsl(var(--w-s));color:hsl(var(--w))}.tag-lo{background:hsl(var(--s-s));color:hsl(var(--s))}.tag-b{background:hsl(var(--brand-s));color:hsl(var(--brand))}
.av{width:22px;height:22px;border-radius:50%;background:hsl(var(--brand-s));color:hsl(var(--brand));display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0}
.av-sm{width:18px;height:18px;font-size:9px}
.view-off{display:none!important}
.divider{border-top:1px solid hsl(var(--e-d))}
.hover-row{padding:10px 16px;border-bottom:1px solid hsl(var(--e-d));transition:background 0.1s}
.hover-row:hover{background:hsl(var(--sf-h))}
.progress{height:6px;background:hsl(var(--sf-h));border-radius:99px;overflow:hidden}
.progress-bar{height:100%;border-radius:99px;transition:width 0.3s}
.progress-bar.brand{background:hsl(var(--brand))}.progress-bar.success{background:hsl(var(--s))}.progress-bar.warn{background:hsl(var(--w))}

/* ═══ BOARD ═══ */
.board-scroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:8px}
.bcol{min-width:270px;max-width:270px;background:hsl(var(--sf-c));border:1px solid hsl(var(--e-d));border-radius:var(--r);display:flex;flex-direction:column}
.bcol-hd{padding:12px 14px;border-bottom:1px solid hsl(var(--e-d));display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.bcol-hd h4{font-size:13px;font-weight:600}
.bcol-cnt{font-size:11px;color:hsl(var(--i-m));background:hsl(var(--sf-h));padding:1px 7px;border-radius:99px}
.bcol-bd{padding:8px;flex:1;min-height:60px}
.bcard{background:hsl(var(--sf-c));border:1px solid hsl(var(--e-d));border-radius:var(--r);padding:10px 12px;margin-bottom:6px;font-size:13px;cursor:grab;box-shadow:var(--sh)}
.bcard:hover{box-shadow:var(--sh-h)}
.bcard .k{font-family:'JetBrains Mono',monospace;font-size:11px;color:hsl(var(--i-m))}
.bcard .t{font-weight:500;margin:4px 0;line-height:1.4}
.bcard .m{display:flex;align-items:center;gap:6px;margin-top:6px}

/* ═══ ISSUE DETAIL ═══ */
.detail-layout{max-width:900px}
.detail-hd{margin-bottom:20px}
.detail-id{font-family:'JetBrains Mono',monospace;font-size:14px;color:hsl(var(--i-m))}
.detail-title{font-size:22px;font-weight:700;margin:6px 0 12px}
.detail-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:12px;color:hsl(var(--i-s))}
.detail-body{display:grid;grid-template-columns:1fr 260px;gap:24px}
.detail-desc{font-size:14px;line-height:1.7}
.detail-sidebar .side-item{padding:8px 0;border-bottom:1px solid hsl(var(--e-d))}
.detail-sidebar .side-label{font-size:11px;font-weight:600;color:hsl(var(--i-m));text-transform:uppercase;letter-spacing:0.04em;margin-bottom:4px}

/* ═══ TAB BAR ═══ */
.tabs{display:flex;border-bottom:1px solid hsl(var(--e-d));gap:0}
.tab{padding:10px 18px;font-size:13px;font-weight:500;color:hsl(var(--i-s));border-bottom:2px solid transparent;transition:all 0.15s;cursor:pointer}
.tab:hover{color:hsl(var(--i-p))}
.tab.act{color:hsl(var(--brand));border-bottom-color:hsl(var(--brand))}
.risk-l{left:3px}

/* ═══ FORM ═══ */
.form-grp{margin-bottom:16px}
.form-label{display:block;font-size:12px;font-weight:600;color:hsl(var(--i-s));margin-bottom:4px}
.form-input{width:100%;padding:8px 12px;border:1px solid hsl(var(--e-d));border-radius:var(--r);font-size:13px;font-family:inherit;background:hsl(var(--sf-c))}
.form-input:focus{outline:none;border-color:hsl(var(--brand));box-shadow:0 0 0 3px hsl(var(--brand)/.1)}
.form-textarea{min-height:120px;resize:vertical;font-family:inherit}
.form-row{display:flex;gap:12px}.form-row>*{flex:1}
.form-select{padding:8px 12px;border:1px solid hsl(var(--e-d));border-radius:var(--r);font-size:13px;background:hsl(var(--sf-c))}

/* ═══ GANTT ═══ */
.gantt-row{display:flex;align-items:center;border-bottom:1px solid hsl(var(--e-d));height:38px}
.gantt-label{width:260px;flex-shrink:0;padding:0 12px;font-size:12px;display:flex;align-items:center;gap:8px}
.gantt-timeline{flex:1;position:relative;height:100%}
.gantt-bar{position:absolute;top:8px;height:22px;border-radius:4px;display:flex;align-items:center;padding:0 8px;font-size:10px;font-weight:600;cursor:pointer;transition:opacity 0.15s;white-space:nowrap;overflow:hidden}
.gantt-bar:hover{opacity:0.85}
.gantt-marker{position:absolute;top:0;width:2px;height:100%;background:hsl(var(--d))}

/* ═══ BURNDOWN ═══ */
.burndown{position:relative;height:200px;border-bottom:1px solid hsl(var(--e-d));overflow:hidden}
.burndown svg{width:100%;height:100%}

/* ═══ AUTH PAGES ═══ */
.auth-page{min-height:100vh;display:flex;align-items:center;justify-content:center;background:hsl(var(--sf-a))}
.auth-card{width:100%;max-width:400px}
.auth-logo{text-align:center;margin-bottom:24px}
.auth-logo-icon{width:40px;height:40px;margin:0 auto 8px;border-radius:var(--r);background:hsl(var(--brand));display:flex;align-items:center;justify-content:center;color:hsl(var(--brand-t));font-weight:700;font-size:16px}
.auth-logo-text{font-size:11px;font-weight:500;color:hsl(var(--i-m));letter-spacing:0.03em}
.auth-form-item{margin-bottom:14px}
.auth-form-label{display:block;font-size:12px;font-weight:600;color:hsl(var(--i-s));margin-bottom:4px}
.auth-form-input{width:100%;padding:9px 12px;border:1px solid hsl(var(--e-d));border-radius:var(--r);font-size:13px;font-family:inherit;background:hsl(var(--sf-c))}
.auth-form-input:focus{outline:none;border-color:hsl(var(--brand));box-shadow:0 0 0 3px hsl(var(--brand)/.1)}
.auth-link{font-weight:500;color:hsl(var(--brand))}

/* ═══ STAT CARD DASH ═══ */
.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.sc{padding:16px 18px;background:hsl(var(--sf-c));border:1px solid hsl(var(--e-d));border-radius:var(--r);box-shadow:var(--sh)}
.sc .lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:hsl(var(--i-m))}
.sc .val{font-size:26px;font-weight:700;margin-top:4px}
.sc .sub{font-size:11px;color:hsl(var(--i-m));margin-top:2px}
.ai-glow{position:relative}.ai-glow::before{content:'';position:absolute;inset:-1px;border-radius:var(--r);background:linear-gradient(135deg,hsl(var(--brand)/.15),transparent 60%);pointer-events:none;z-index:0}
.ai-glow>*{position:relative;z-index:1}
.pulse{display:inline-block;width:6px;height:6px;border-radius:50%;background:hsl(var(--brand));margin-right:6px;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

/* ═══ RESPONSIVE HINT ═══ */
@media(max-width:1024px){.sb{width:52px}.sb-logo-text,.sb-label,.nav span:not(.badge),.sb-foot-btn span,.sb-sep{display:none}.nav{gap:0;justify-content:center}}
</style>
</head>
<body>

<div class="layout">

<!-- ══════════════ SIDEBAR ══════════════ -->
<aside class="sb">
  <div class="sb-logo"><div class="sb-logo-icon">A</div><span class="sb-logo-text">TomatoHub</span></div>

  <nav class="sb-nav">
    <a class="nav" onclick="document.getElementById('notif-panel').classList.toggle('view-off')" href="javascript:void(0)" style="position:relative">
      <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
      <span>Notifications</span>
      <span class="badge" style="position:absolute;right:10px;background:hsl(var(--danger));min-width:18px;text-align:center">3</span>
    </a>
    <a class="nav act" data-v="dash" onclick="show('dash')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.707 2.293a1 1 0 00-1.414 0l-7 7A1 1 0 003 11h1v6a1 1 0 001 1h4v-4a1 1 0 011-1h2a1 1 0 011 1v4h4a1 1 0 001-1v-6h1a1 1 0 00.707-1.707l-7-7z" clip-rule="evenodd"/></svg>
      <span>Home</span>
    </a>

    <div class="sb-sep"></div>
    <div class="sb-label">Project / AIPM</div>
    <a class="nav" data-v="project-home" onclick="show('project-home')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 0h8v12H6V4zm2 2a1 1 0 000 2h4a1 1 0 100-2H8z" clip-rule="evenodd"/></svg>
      <span>Overview</span>
    </a>
    <a class="nav" data-v="board" onclick="show('board')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1V6a1 1 0 011-1h4zM4 13a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zm10-1a1 1 0 00-1 1v3a1 1 0 001 1h4a1 1 0 001-1v-3a1 1 0 00-1-1h-4z"/></svg>
      <span>Board</span>
    </a>
    <a class="nav" data-v="issues" onclick="show('issues')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 4.5a1 1 0 012 0v1.5h2.5a1 1 0 010 2H11v2.5a1 1 0 01-2 0V8H6.5a1 1 0 010-2H9V4.5zM3.5 4a1 1 0 00-1 1v11a1 1 0 001 1h11a1 1 0 001-1V5a1 1 0 00-1-1h-11z" clip-rule="evenodd"/></svg>
      <span>Issues</span><span class="badge">8</span>
    </a>
    <a class="nav" data-v="issue-detail" onclick="show('issue-detail')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
      <span>Issue Detail</span>
    </a>
    <a class="nav" data-v="issue-create" onclick="show('issue-create')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
      <span>Create Issue</span>
    </a>
    <a class="nav" data-v="sprints" onclick="show('sprints')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v4l3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span>Sprints</span>
    </a>
    <a class="nav" data-v="gantt" onclick="show('gantt')" href="javascript:void(0)">
      <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h8a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h10a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
      <span>Gantt</span>
    </a>
    <a class="nav" data-v="settings" onclick="show('settings')" href="javascript:void(0)">
