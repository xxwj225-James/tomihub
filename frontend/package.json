{
  "name": "ai-pm-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-PM Frontend — React + TypeScript + Tailwind CSS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@milkdown/kit": "^7.21.3",
    "@milkdown/react": "^7.21.3",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-router": "^1.95.0",
    "@types/dompurify": "^3.0.5",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "lint-staged": {
