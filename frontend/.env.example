# Frontend Environment Variables
# Copy to .env: cp .env.example .env

# API base URL
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL
VITE_WS_URL=ws://localhost:8080/ws

# Feature flags
# true → AI features visible (full/enterprise with ai-brain). Open-source
# edition (no engine) should build with false.
VITE_ENABLE_AI_FEATURES=true
# true → cloud live-demo chrome only (guest "Try demo", read-only demo
# account, AI quotas/banners). Normal installs keep false so users can
# register and use the product.
VITE_ENABLE_DEMO_MODE=false
# Optional: demo visitor email suffix (only read when VITE_ENABLE_DEMO_MODE=true)
# VITE_DEMO_EMAIL_SUFFIX=@tomihub.demo
VITE_ENABLE_GANTT=true
